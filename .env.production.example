# ==========================================
# Keel CRM — Production Environment Template
# ==========================================

# 1. Server & Host Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# 2. Database Connection (Local SQLite or Turso/LibSQL Cloud)
# For local container volume:
DATABASE_URL=file:/app/data/keel.db

# For Turso / LibSQL Cloud Serverless Database:
# DATABASE_URL=libsql://your-database-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-jwt-auth-token

# 3. Authentication (NextAuth v5)
# Generate a 32+ character random secret: openssl rand -base64 32
AUTH_SECRET=replace_with_a_secure_random_secret_32_characters_long
NEXTAUTH_URL=https://your-crm-domain.com

# 4. Google Gemini 2.5 AI Engine (Optional)
# Leave blank to run in resilient heuristic fallback mode
GEMINI_API_KEY=your_gemini_api_key_here

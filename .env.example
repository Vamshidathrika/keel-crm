# -------------------------------------------------------------
# Keel CRM - Production Environment Configuration
# -------------------------------------------------------------

# NextAuth Secret (Generate via `openssl rand -base64 32`)
AUTH_SECRET="your-32-character-random-secret-key-here"
NEXTAUTH_URL="https://keel-crm.vercel.app"

# Database Configuration (Turso LibSQL for Serverless Production)
DATABASE_URL="libsql://your-database-name.turso.io"
DATABASE_AUTH_TOKEN="your-turso-database-auth-token"

# AI Model Provider API Keys (Optional / for Real-time AI)
GOOGLE_API_KEY=""
GEMINI_API_KEY=""

# Background Cron Secret (Optional / for Triggering Automated Sweeps)
CRON_SECRET="your-cron-secret-key"

# Resend & WhatsApp API Keys (Optional / for Omnichannel Messaging)
RESEND_API_KEY=""
WH_API_KEY=""

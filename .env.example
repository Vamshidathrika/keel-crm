# NEVER put real keys in this file — it is committed to git. Copy to .env.local and fill in.

# SQLite (libsql) database file. Swap to a Turso URL + authToken later with zero code changes.
DATABASE_URL="file:./local.db"
DATABASE_AUTH_TOKEN=""

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google Gemini — same key as the Vani AI voice-agent app
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
